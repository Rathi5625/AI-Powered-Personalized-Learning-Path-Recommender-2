# Database (Supabase PostgreSQL)
# Format 1 (Direct Connection, Port 5432):
# DB_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
#
# Format 2 (Supabase Session Pooler, Port 5432):
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<your-project-ref>
#
# Note: DB_URL owns the full "jdbc:postgresql://" prefix.
DB_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# LLM Provider (NVIDIA NIM or any OpenAI-compatible provider)
# For NVIDIA NIM: use https://integrate.api.nvidia.com/v1 with your nvapi-... key.
# The same nvapi-... key can be used for both LLM_API_KEY and EMBEDDING_API_KEY.
LLM_API_KEY=nvapi-your_nvidia_api_key
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Embeddings (NVIDIA NIM or OpenAI-compatible)
EMBEDDING_API_KEY=nvapi-your_nvidia_api_key
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1

# App
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth & Email Verification
# Set to 'true' to require OTP email verification before login, or 'false' for direct demo logins.
REQUIRE_EMAIL_VERIFICATION=true

# Optional SMTP Email Configuration (If absent, ConsoleEmailService logs OTP to terminal in DEV mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Curated Spreadsheet Data Import (Set to 'true' for a single boot to import Excel learning resources)
APP_IMPORT_ENABLED=false

